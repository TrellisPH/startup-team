#!/usr/bin/env bash
# Local guard: refuse a push when any commit being pushed (files or message) contains a word from
# .git/private-words.txt. The word list lives inside .git, so it is never pushed itself.
words="$(git rev-parse --git-dir)/private-words.txt"
[ -s "$words" ] || exit 0
pattern="$(grep -v '^#' "$words" | sed '/^$/d' | sed 's/[.[\*^$]/\&/g' | paste -sd'|')"
fail=0
while read -r _ local_sha _ remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then range="$local_sha"; else range="$remote_sha..$local_sha"; fi
  for c in $(git rev-list "$range"); do
    if git grep -niE "$pattern" "$c" -- . >/dev/null 2>&1; then
      echo "push refused: commit ${c:0:7} has a private word in its files:"; git grep -niE "$pattern" "$c" -- . | cut -c1-120 | head -5; fail=1
    fi
    if git log -1 --format='%s%n%b' "$c" | grep -qiE "$pattern"; then
      echo "push refused: commit ${c:0:7} has a private word in its message."; fail=1
    fi
  done
done
exit $fail
